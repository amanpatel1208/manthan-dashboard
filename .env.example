# ============================================================
# Mathan Institute Dashboard - Environment Configuration
# ============================================================

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# Server Port (Render sets this automatically)
PORT=3000

# Session Secret (Generate a strong random 32+ character string)
SESSION_SECRET=your_super_secret_session_key_here

# ------------------------------------------------------------
# Database Configuration (NeonDB / PostgreSQL)
# ------------------------------------------------------------
# Option A: Full Connection String (Standard on NeonDB, Render, Supabase)
# Example NeonDB: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Option B: Discrete Parameters (Used if DATABASE_URL is not set)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=manthan_institute
DB_PORT=5432
DB_SSL=false
DB_POOL_MAX=10

# ------------------------------------------------------------
# Security & Network (Netlify + Render)
# ------------------------------------------------------------
# Set to 'true' on Render / reverse proxy
TRUST_PROXY=true

# Set to 'true' for HTTPS in production
COOKIE_SECURE=true

# 'none' for cross-domain Netlify -> Render; 'lax' for same-domain
COOKIE_SAMESITE=none

# Allowed frontend origin (e.g. https://your-site.netlify.app or * for all)
CORS_ORIGIN=*

# ------------------------------------------------------------
# Initial Setup (Used only on initial setup-db run)
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_EMAIL=admin@manthaninstitute.com

# ------------------------------------------------------------
# Default Institute UPI Details (Optional)
# ------------------------------------------------------------
UPI_ID=
UPI_NAME=Mathan Institute
